{
  "name": "license-system-frontend",
  "version": "1.0.0",
  "description": "Production License Management UI",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/css/style.css -o dist/style.css --minify",
    "build:js": "terser src/js/*.js -o dist/bundle.js --compress --mangle",
    "watch": "npm run build && live-server dist"
  },
  "devDependencies": {
    "postcss-cli": "^10.1.0",
    "autoprefixer": "^10.4.15",
    "cssnano": "^6.0.1",
    "terser": "^5.19.3",
    "live-server": "^1.2.2"
  }
}